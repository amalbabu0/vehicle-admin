# Supabase project (same project as the user app). No NEXT_PUBLIC_ prefix on
# any of these, including SUPABASE_URL/SUPABASE_ANON_KEY — the browser client
# gets them at runtime via /api/public-config instead of at build time. See
# lib/env.ts for why (they're still visible to visitors either way; this only
# changes delivery, not actual secrecy).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used only in Server Actions/Route Handlers for
# privileged admin operations (approvals, cross-user management). Never
# exposed to the client, never referenced from app/api/public-config.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (image storage) — this app holds the write-capable
# credentials. Account ID is in the Cloudflare dashboard sidebar; R2 access
# keys come from R2 -> Manage API Tokens (scope: Object Read & Write, this
# bucket only).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=vehicle-images
# Public custom domain connected to the R2 bucket (R2 bucket -> Settings ->
# Custom Domains). No trailing slash.
IMAGES_CDN_URL=https://cdn.example.com

# Upstash Redis (rate limiting, cache)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile (bot protection on auth forms)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

SITE_URL=https://admin.example.com
# The public user site's URL (different domain) — used to build shareable
# vehicle links, e.g. WhatsApp sharing from the vehicle list.
PUBLIC_SITE_URL=https://www.example.com
# Shared secret with the user app's POST /api/revalidate. Generate with
# `openssl rand -hex 32`; must match the user app's REVALIDATE_SECRET exactly.
REVALIDATE_SECRET=your-shared-revalidate-secret

# Vercel Cron shared secret — sent as `Authorization: Bearer <CRON_SECRET>`
# on every scheduled request (see vercel.json). Generate with
# `openssl rand -hex 32`.
CRON_SECRET=your-cron-secret

# Groq API key (console.groq.com) — Quick Listing's WhatsApp-message field
# extraction. Server-only and billed per token; never expose to the client.
GROQ_API_KEY=your-groq-api-key
