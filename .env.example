# Supabase project (same project as the user app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used only in Server Actions/Route Handlers for
# privileged admin operations (approvals, cross-user management). Never expose
# to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Images — this app holds the upload-capable token.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_IMAGES_API_TOKEN=your-cloudflare-images-api-token
NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=your-cloudflare-images-delivery-hash

# Upstash Redis (rate limiting, cache)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile (bot protection on auth forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=https://admin.example.com
